<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DBA Admin Console</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #000000;
            color: #ffffff;
            line-height: 1.6;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .auth-container {
            max-width: 400px;
            margin: 50px auto;
            background-color: #1a1a1a;
            padding: 40px;
            border-radius: 8px;
            border: 1px solid #333;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 5px;
            color: #ffffff;
            font-weight: 500;
        }
        
        input[type="text"], input[type="email"], input[type="password"], select {
            width: 100%;
            padding: 12px;
            background-color: #000000;
            border: 2px solid #333;
            border-radius: 4px;
            color: #ffffff;
            font-size: 14px;
        }
        
        input[type="text"]:focus, input[type="email"]:focus, input[type="password"]:focus, select:focus {
            outline: none;
            border-color: #ffffff;
        }
        
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 500;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            transition: all 0.3s ease;
        }
        
        .btn-primary {
            background-color: #ffffff;
            color: #000000;
        }
        
        .btn-primary:hover {
            background-color: #f0f0f0;
        }
        
        .btn-secondary {
            background-color: transparent;
            color: #ffffff;
            border: 2px solid #ffffff;
        }
        
        .btn-secondary:hover {
            background-color: #ffffff;
            color: #000000;
        }
        
        .alert {
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 4px;
            font-weight: 500;
        }
        
        .alert-success {
            background-color: #1a4d1a;
            color: #00ff00;
            border: 1px solid #00ff00;
        }
        
        .alert-warning {
            background-color: #4d3d1a;
            color: #ff8800;
            border: 1px solid #ff8800;
        }
        
        .alert-danger {
            background-color: #4d1a1a;
            color: #ff0000;
            border: 1px solid #ff0000;
        }
        
        .text-center {
            text-align: center;
        }
        
        .mt-3 {
            margin-top: 1rem;
        }
        
        .mb-3 {
            margin-bottom: 1rem;
        }
        
        .link {
            color: #ffffff;
            text-decoration: underline;
        }
        
        .link:hover {
            color: #f0f0f0;
        }
        
        .checkbox-container {
            display: flex;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        
        .checkbox-container input[type="checkbox"] {
            width: auto;
            margin-right: 10px;
            margin-top: 3px;
        }
        
        .qr-code-container {
            text-align: center;
            margin: 30px 0;
            padding: 20px;
            background-color: #000000;
            border: 2px solid #333;
            border-radius: 8px;
        }
        
        .secret-key {
            background-color: #000000;
            border: 2px solid #333;
            padding: 15px;
            margin: 20px 0;
            font-family: monospace;
            letter-spacing: 2px;
            word-break: break-all;
        }
    </style>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body>
    <div class="container">
        @RenderBody()
    </div>
</body>
</html>
