# Production Environment Variables Template

# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to version control!

# Backend API URL (will be provided after backend deployment)
REACT_APP_API_URL=https://your-backend-url.azurewebsites.net

# Google reCAPTCHA Site Key (production key)
REACT_APP_RECAPTCHA_SITE_KEY=your-production-recaptcha-site-key
